@page "/"
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject ThemeService ThemeService
@implements IDisposable

<button class="mode-toggle" @onclick="ToggleDarkMode">
    @(ThemeService.IsDarkMode ? "☀️ Light Mode" : "🌙 Dark Mode")
</button>

<div class="dashboard @(ThemeService.IsDarkMode ? "dark-mode" : "light-mode")">

    @if (_loadError is not null)
    {
        <div class="chart-card large">
            <h3>⚠️ Não foi possível carregar os dados</h3>
            <p>@_loadError</p>
            <p>Verifique se o json-server está rodando (<code>npm run api</code>) na porta 3001.</p>
        </div>
    }
    else if (_data is null)
    {
        <p>Carregando dados...</p>
    }
    else
    {
        <div class="stats-grid">
            @foreach (var stat in _data.Stats)
            {
                <div class="stat-card @stat.Key">
                    <div class="stat-icon">@stat.Icon</div>
                    <div class="stat-content">
                        <h3>@stat.Label</h3>
                        <h2>@stat.Value</h2>
                        <span class="stat-trend @stat.TrendType">@stat.Trend</span>
                    </div>
                </div>
            }
        </div>

        <div class="charts-row">
            <div class="chart-card large">
                <h3>📈 Evolução de Vendas - Últimos 12 Meses</h3>
                <div id="lineChart" style="width: 100%; height: 350px;"></div>
            </div>
        </div>

        <div class="charts-row">
            <div class="chart-card medium">
                <h3>🍕 Distribuição por Categoria</h3>
                <div id="pieChart" style="width: 100%; height: 300px;"></div>
            </div>
            <div class="chart-card medium">
                <h3>🏆 Top 5 Produtos Mais Vendidos</h3>
                <div id="barChart" style="width: 100%; height: 300px;"></div>
            </div>
        </div>

        <div class="charts-row">
            <div class="chart-card large">
                <h3>🌐 Tráfego do Site - Últimos 30 Dias</h3>
                <div id="areaChart" style="width: 100%; height: 300px;"></div>
            </div>
        </div>

        <!-- Métricas Secundárias -->
        <div class="secondary-stats">
            @foreach (var secondary in _data.SecondaryStats)
            {
                <div class="secondary-card">
                    <h4>@secondary.Icon @secondary.Label</h4>
                    <div class="secondary-value">@secondary.Value</div>
                </div>
            }
        </div>
    }
</div>

@code {
    private DashboardData? _data;
    private string? _loadError;
    private bool _chartsInitialized;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("DashboardApi");
            _data = await client.GetFromJsonAsync<DashboardData>(
                "db",
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ThemeService.OnThemeChanged += OnThemeChanged;
        }

        if (_data is not null && !_chartsInitialized)
        {
            await EnsureEChartsLoadedAsync();
            await InitializeCharts();
            _chartsInitialized = true;
        }
    }

    private async Task EnsureEChartsLoadedAsync()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            if (!window.echarts) {
                var script = document.createElement('script');
                script.src = 'https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js';
                document.head.appendChild(script);
            }
        ");

        for (int i = 0; i < 30; i++)
        {
            bool loaded = await JSRuntime.InvokeAsync<bool>("isEChartsLoaded");
            if (loaded) return;
            await Task.Delay(100);
        }

        Console.WriteLine("⚠️ ECharts não carregou em tempo hábil.");
    }

    private async Task InitializeCharts()
    {
        if (_data is null) return;

        var chartsPayload = new
        {
            lineChart = _data.LineChart,
            pieChart = _data.PieChart,
            barChart = _data.BarChart,
            areaChart = _data.AreaChart
        };

        await JSRuntime.InvokeVoidAsync(
            "initializeDashboardCharts",
            ThemeService.IsDarkMode ? "dark" : "light",
            chartsPayload);
    }

    private async void OnThemeChanged()
    {
        await InvokeAsync(StateHasChanged);
        if (_chartsInitialized)
        {
            await JSRuntime.InvokeVoidAsync("updateDashboardChartsTheme", ThemeService.IsDarkMode ? "dark" : "light");
        }
    }

    private void ToggleDarkMode() => ThemeService.ToggleTheme();

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= OnThemeChanged;
    }
}
